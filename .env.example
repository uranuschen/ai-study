# 模型及检索配置复制到 .env；数据库连接单独修改根目录 .env.db。
# 数据库 URL 格式：postgresql://用户名:密码@主机:端口/数据库名。
# DATABASE_URL=postgresql://rag:YOUR_PASSWORD@localhost:5432/ragdb
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=YOUR_KEY
LLM_MODEL=deepseek-chat
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
RERANK_MODEL=BAAI/bge-reranker-base
# 默认仅加载已有缓存；需要下载时由用户自行改为 false。
LOCAL_FILES_ONLY=true
CHUNK_SIZE=400
CHUNK_OVERLAP=80
PARENT_SIZE=1200
RECALL_K=20
CANDIDATE_K=20
TOP_K=5
FUSION=rrf
VECTOR_WEIGHT=0.5
MIN_VECTOR_SCORE=0.35
MIN_RERANK_SCORE=0.35
CONTEXT_CHARS=3500
PER_CHUNK_CHARS=700
BM25_MAX_CHUNKS=10000
